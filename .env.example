# Copy to .env and adjust. Every setting has a sensible default.

# Claude extraction. With EXTRACTOR=auto, Claude is used when an API key is set,
# otherwise the deterministic regex baseline.
ANTHROPIC_API_KEY=
# auto | claude | heuristic
EXTRACTOR=auto
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# also send the PDF itself to Claude (helps on poor scans)
ATTACH_PDF_TO_LLM=false

# Routing: fields below this confidence go to the review queue.
CONFIDENCE_THRESHOLD=0.80

# Local development (outside Docker)
DATABASE_URL=postgresql+psycopg://claimlens:claimlens@localhost:5432/claimlens
REDIS_URL=redis://localhost:6379/0

# Host ports for docker compose (change if they clash with other services)
API_PORT=8000
UI_PORT=8080
DB_PORT=5432
REDIS_PORT=6379
